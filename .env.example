# Copy to .env.production and fill in from:
#   firebase apps:sdkconfig WEB <appId> --project <projectId>
#
# Not secrets: a Firebase web config compiles into the client bundle and is
# public by design. firestore.rules and storage.rules are what protect the data.
# Without these set, src/services/firebase.js falls back to dummy values and the
# built site points at a project that does not exist.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA Enterprise site key for App Check (Cloud console > Fraud Defense >
# Keys). Public, like the config above. Optional: App Check is off if unset.
VITE_RECAPTCHA_SITE_KEY=
# Dev only: point Firestore at the local emulator instead of the live database,
# e.g. 127.0.0.1:8080. Put it in .env.local, never in .env.production.
# VITE_FIRESTORE_EMULATOR_HOST=
