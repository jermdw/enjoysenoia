        "map-pdf": {
          "fileId": "6501de6d4e01a1ed893bc328",
          "url": "https://uploads-ssl.webflow.com/62c89378d6e1292fdfcdd98a/6501de6d4e01a1ed893bc328_venue-map-sand-boards-revised-9-13-23-small.pdf",
          "alt": null
        },
        "highlights": "<h3 id=\"\">Event Highlights</h3><p id=\"\"><br><a id=\"\" href=\"#details\">Click here</a> for the schedule of events....<br><br>Text JOIN to 18334173760 for event updates via text - you can unsubscribe at any time.</p><p id=\"\">‍</p><h3 id=\"\">Show Cars - Reserved and Non-Reserved &amp; General Parking Paid Ticket Holders (Not Spectators or General Public)</h3><p id=\"\">All paid show car parking ticket holders should have received an email with instructions for the day of the event (note there are some changes from last year). Although pre-registered, show car ticket holders <strong id=\"\">still must check in</strong> to complete the registration process. See the email sent to show car ticket holders <a href=\"https://uploads-ssl.webflow.com/62c89378d6e12946d6cdd965/6516a1407614d7887e7126a6_show-car-paid-parking-parking.pdf\" target=\"_blank\">here.</a></p><p id=\"\">‍</p><h3 id=\"\">Downtown Senoia Business Directory</h3><p id=\"\"><a id=\"\" href=\"https://www.enjoysenoia.com/downtown-businesses\" target=\"_blank\">Click here</a> for a directory of downtown Senoia Businesses including restaurants, shops and services.</p><p id=\"\">‍</p><h3 id=\"\">Public Parking - FREE</h3><p id=\"\"><em id=\"\">click on any location for directions</em></p><p id=\"\">‍</p><p id=\"\"><a id=\"\" href=\"https://goo.gl/maps/aT9rNkXZUCq8RDFM6\" target=\"_blank\">Senoia Public Library</a> - shuttle provided</p><p id=\"\"><br><a id=\"\" href=\"https://goo.gl/maps/QTgKtawCLdx4pLdS7\" target=\"_blank\">Seavy Street Park</a> - shuttle provided</p><p id=\"\"><br><a id=\"\" href=\"https://goo.gl/maps/rQBWV8ZXgaUgdaq77\" target=\"_blank\">Main St just north of Ray Street</a> - shuttle provided</p><p id=\"\">‍</p><p id=\"\"><a id=\"\" href=\"https://goo.gl/maps/PSAM1oHuhbbwKYnHA\" target=\"_blank\">Grass Lot at Bridge St. Between Seavy St. and Johnson St.</a></p><p id=\"\"><br><a id=\"\" href=\"https://goo.gl/maps/sSLPnS5DAhGWQb4r9\" target=\"_blank\">All along Pylant Street</a> from the Library up to Gin Street</p><p id=\"\">‍</p><h3 id=\"\">Handicap Parking</h3><p id=\"\"><em id=\"\">click on any location for directions</em></p><p id=\"\">‍</p><p id=\"\"><a id=\"\" href=\"https://goo.gl/maps/f5dDH8W2DPS9pLTs5\" target=\"_blank\">Senoia Post Office</a></p><p id=\"\"><br><a id=\"\" href=\"https://goo.gl/maps/mHT8cesLbYAUyenK7\" target=\"_blank\">Senoia First Baptist Church</a></p><p id=\"\"><br><a id=\"\" href=\"https://goo.gl/maps/aT9rNkXZUCq8RDFM6\" target=\"_blank\">Senoia Library</a></p>",
        "highlight-background-color": null,
        "highlight-text-color": null,
        "highlights-background-image": {
          "fileId": "6356e3d0cd5b4f1d3647351f",
          "url": "https://uploads-ssl.webflow.com/62c89378d6e1292fdfcdd98a/6356e3d0cd5b4f1d3647351f_DSCF6011.jpg",
          "alt": null
        },
        "highlight-image": null,
        "highlight-image-or-map-pdf": null,
        "schedule-background-color": null,
        "schedule-section-overlay-background-image": null,
        "faq-background-color": null,
        "sponsor-logos": null,
        "faq-ovrlay-background-image": null,
        "sponsor-type": "d75f629cfd7d3d7a4844a4490be4cf7c",
        "vip-ticket-embed": null,
        "vip-tickets-and-info": null,
        "general-info": "<h2 id=\"\"><strong id=\"\">Schedule of Events</strong></h2><p id=\"\"><strong id=\"\">(</strong>Times/content subject to change)</p><ul id=\"\"><li id=\"\">7:00am: Gates Open for Show Cars</li><li id=\"\">8:00am: Gates Open for Sponsors/Vendors</li><li id=\"\">10:00am: Car Show Officially Open</li><li id=\"\">10:30am: Pedal Car Silent Auction Begins </li><li id=\"\">11:30am: Valve Cover Race 1</li><li id=\"\">12:00pm: \"Crank your Engines\"</li><li id=\"\">12:30pm: Valve Cover Race 2</li><li id=\"\">1:00pm: Fly Over </li><li id=\"\">1:30pm: Valve Cover Race 3 </li><li id=\"\">2:00p Pedal Car Silent Auction Ends</li><li id=\"\">3:00 Awards Ceremony</li><li id=\"\">4:00 Show Ends</li></ul><p id=\"\">‍</p><p id=\"\">‍</p><h2 id=\"\"><strong id=\"\">Multiple Events Within the Car Show</strong></h2><ul id=\"\"><li id=\"\">500 collector cars</li><li id=\"\">Pedal Car Auction - local shops have customized pedal cars to look like classic cars and hot-rods, bid on these one-of-a-kind collector items! &nbsp;Proceeds to benefit the family of Toby Bowden, a retired marine and father who was killed on duty as a local tow truck driver.</li><li id=\"\">Valve cover races - you've heard of pinewood derby races, well this is similar except with customized valve covers - fun for the kid in all of us! <a id=\"\" href=\"https://www.dropbox.com/s/bfc4ga92bydmwyg/Valve%20Cover%20Races.pdf?dl=0\" target=\"_blank\">Click here</a> for more info about the Valve Cover races.</li><li id=\"\">I-58 Food drive. Please support our efforts by bringing canned goods to the designated collection points at the Senoia Car Show. The I-58 Mission follows the call of Isaiah 58. They meet the physical needs (such as food) and share the love of Christ with the Senoia area community. <a id=\"\" href=\"https://thei58mission.org/\" target=\"_blank\">Click here</a> for more info about the I-58 Mission.</li><li id=\"\">Food Trucks - including the Varsity and other local favorites</li><li id=\"\">Trophies include Gail Downs Memorial (Best in Show Car, Best in Show Truck) and Top 20 in Show</li></ul><p id=\"\">‍</p><p id=\"\">‍</p>",
