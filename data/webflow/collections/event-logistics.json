        "sponsor-type": "d75f629cfd7d3d7a4844a4490be4cf7c",
        "vip-ticket-embed": "<div data-rt-embed-type='true'><!-- Ticket Tailor Widget. Paste this into your website where you want the widget to appear. Do not change the code or the widget may not work properly. -->\n<div class=\"tt-widget\"><div class=\"tt-widget-fallback\"><p><a href=\"https://www.tickettailor.com/checkout/new-session/id/2691344/chk/5585/\" target=\"_blank\">Click here to buy tickets</a><br /><small><a href=\"https://www.tickettailor.com?rf=wdg_121784\" class=\"tt-widget-powered\">Sell tickets online with Ticket Tailor</a></small></p></div><script src=\"https://cdn.tickettailor.com/js/widgets/min/widget.js\" data-url=\"https://www.tickettailor.com/checkout/new-session/id/2691344/chk/5585/\" data-type=\"inline\" data-inline-minimal=\"true\" data-inline-show-logo=\"false\" data-inline-bg-fill=\"false\" data-inline-inherit-ref-from-url-param=\"\" data-inline-ref=\"\"></script></div>\n<!-- End of Ticket Tailor Widget --></div>",
        "vip-tickets-and-info": "<p id=\"\">Tickets for the VIP concert from 7:00 - 10:00 PM are available for purchase. <br><br>Cowboy Noyz featuring tunes from AC/DC to Hank Williams will be opening the festivities beginning at 7 PM at the Gin Street stage.</p><figure id=\"\" class=\"w-richtext-figure-type-image w-richtext-align-center\" data-rt-type=\"image\" data-rt-align=\"center\"><div id=\"\"><img id=\"\" src=\"https://uploads-ssl.webflow.com/62c89378d6e1292fdfcdd98a/66ca302c72f1594d10e613a2_64d50d809f9d2041daf8e0bb_cowboy%2520noyz-p-800.jpeg\" width=\"auto\" height=\"auto\" loading=\"lazy\"></div><figcaption id=\"\">Coby Noyz</figcaption></figure><p id=\"\">‍</p><p id=\"\">FLUX will be the main stage act following Cowboy Noyz. FLUX is The Ultimate Live Entertainment Experience playing the best Dance, Rock and New Wave hits.</p><figure id=\"\" class=\"w-richtext-figure-type-image w-richtext-align-center\" data-rt-type=\"image\" data-rt-align=\"center\"><div id=\"\"><img id=\"\" src=\"https://uploads-ssl.webflow.com/62c89378d6e1292fdfcdd98a/66ca302c72f1594d10e6139b_64bbbee14c40f11a7f0e7d64_Flux.jpeg\" width=\"auto\" height=\"auto\" loading=\"lazy\"></div><figcaption id=\"\">FLUX</figcaption></figure><p id=\"\">Click on the \"Purchase VIP&nbsp;Tickets\"&nbsp;button to reserve your spot.</p><p id=\"\">‍</p>",
        "general-info": "<p id=\"\">Artist Alley vendors are located on Pylant Street between Travis and Seavy Streets, <a id=\"\" href=\"https://goo.gl/maps/wkq2w5HAnTEvqeiz5\" target=\"_blank\">click here</a> for a map/directions.<br><br>Food Trucks are located on Gin Street just to the East of Intersection of Gin Street and Lower Creek Trail, <a id=\"\" href=\"https://goo.gl/maps/HrB7anCj8eejLCUF8\" target=\"_blank\">click here</a> for a map/directions.</p><p>‍</p><p id=\"\"><br></p>",
