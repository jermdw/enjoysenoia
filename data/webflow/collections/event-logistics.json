        "hero-overlay-background-image": null,
        "hero-caption": "Welcome to the Senoia Car Show",
        "hero-background-color": "white",
        "venue-map": {
          "fileId": "6501defd036f656d0f438d02",
          "url": "https://uploads-ssl.webflow.com/62c89378d6e1292fdfcdd98a/6501defd036f656d0f438d02_venue-map-sand-boards-revised-9-13-23-app-web.jpg",
