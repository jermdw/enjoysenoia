rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in [
          "jermdw@gmail.com",
          "welcome@enjoysenoia.com",
          "treasurer@enjoysenoia.com",
          "webmaster@enjoysenoia.com"
        ] || request.auth.token.admin == true
      );
    }

    /*
     * Staff edits to the events calendar and downtown directory, merged over
     * the build-time data/site/*.json at runtime by src/services/dataService.js.
     *
     * events/{slug} and businesses/{slug} are keyed by the item's slug. A
     * document whose slug matches a built-in item is a PATCH: only the fields
     * present replace the built-in values, and `hidden: true` removes it from
     * the site. A document whose slug matches nothing is a NEW item. Deleting
     * a patch restores the built-in item.
     *
     * Public read, admin-only write, shape and size checked as for News.
     */
    function optString(d, key, max) {
      return !(key in d) || d[key] == null || (d[key] is string && d[key].size() <= max);
    }

    function isValidEventDoc(slug) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'slug', 'title', 'date_time', 'start', 'end', 'location', 'description',
          'image', 'external_url', 'category', 'hidden',
          'createdAt', 'updatedAt', 'updatedBy'
        ])
        && d.keys().hasAll(['slug', 'hidden'])
        && d.slug == slug
        && slug.matches('^[a-z0-9][a-z0-9-]{0,119}$')
        && d.hidden is bool
        && (!('title' in d) || (d.title is string && d.title.size() > 0 && d.title.size() <= 200))
        && optString(d, 'date_time', 120)
        && optString(d, 'start', 40)
        && optString(d, 'end', 40)
        && optString(d, 'location', 200)
        && optString(d, 'description', 5000)
        && optString(d, 'image', 2000)
        && optString(d, 'external_url', 2000)
        && optString(d, 'category', 80)
        && optString(d, 'updatedBy', 254);
    }

    function isValidBusinessDoc(slug) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'slug', 'name', 'category', 'summary', 'description_html', 'hours_html',
          'phone', 'email', 'website', 'facebook', 'instagram', 'address', 'image',
          'hidden', 'createdAt', 'updatedAt', 'updatedBy'
        ])
        && d.keys().hasAll(['slug', 'hidden'])
        && d.slug == slug
        && slug.matches('^[a-z0-9][a-z0-9-]{0,119}$')
        && d.hidden is bool
        && (!('name' in d) || (d.name is string && d.name.size() > 0 && d.name.size() <= 200))
        && optString(d, 'category', 80)
        && optString(d, 'summary', 300)
        && optString(d, 'description_html', 10000)
        && optString(d, 'hours_html', 2000)
        && optString(d, 'phone', 60)
        && optString(d, 'email', 254)
        && optString(d, 'website', 2000)
        && optString(d, 'facebook', 2000)
        && optString(d, 'instagram', 2000)
        && optString(d, 'address', 300)
        && optString(d, 'image', 2000)
        && optString(d, 'updatedBy', 254);
    }

    match /events/{slug} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidEventDoc(slug);
      allow delete: if isAdmin();
    }

    match /businesses/{slug} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidBusinessDoc(slug);
      allow delete: if isAdmin();
    }

    /*
     * News stories, keyed by slug (the /news/<slug> address). Drafts are
     * admin-only: the public may read a story only once it is published,
     * so every public query must filter on status == 'published' or the
     * rules reject it. See src/services/newsService.js.
     */
    function isValidNewsStory(slug) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'title', 'slug', 'summary', 'bodyHtml', 'image', 'imageAlt',
          'status', 'publishedAt', 'showDate', 'featured', 'eventSlug',
          'createdAt', 'updatedAt', 'updatedBy', 'webflowId', 'firstPublishedAt'
        ])
        && d.keys().hasAll(['title', 'slug', 'status', 'publishedAt'])
        && d.slug == slug
        && slug.matches('^[a-z0-9][a-z0-9-]{0,119}$')
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.status in ['draft', 'published']
        && d.publishedAt is timestamp;
    }

    match /news/{slug} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update: if isAdmin() && isValidNewsStory(slug);
      allow delete: if isAdmin();
    }

    match /downloads/{downloadId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sponsors/{sponsorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /newsletter_subscribers/{subId} {
      // Anyone may subscribe, but only with this exact shape: a plausible
      // email, a server timestamp, and a known source tag.
      allow create: if request.resource.data.keys().hasOnly(['email', 'subscribedAt', 'source'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.subscribedAt == request.time
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 64;
      allow read, update, delete: if isAdmin();
    }

    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /*
     * Senoia Halloween — decorating contest sign-ups.
     *
     * Public create, NO public read. The document holds a name, a home address
     * and an email together; anyone able to read it could harvest the lot. Only
     * the address is ever published, and only via halloween_map_points below.
     */
    match /halloween_signups/{signupId} {
      allow create: if request.resource.data.keys().hasOnly(
          ['name', 'address', 'email', 'category', 'contestCategory', 'status', 'submittedAt', 'source'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 5
        && request.resource.data.address.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.category in ['residential', 'business']
        // The judging lane, separate from who is entering.
        && request.resource.data.contestCategory in ['spooky', 'pumpkinPals']
        // Pinned, so a submitter cannot approve their own entry onto the map.
        && request.resource.data.status == 'pending'
        && request.resource.data.submittedAt == request.time
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 64;
      allow read, delete: if isAdmin();
      // Shape is enforced on this path too, not just on create. The publish
      // flow adds `mapPointId`, which is why it is listed here and not above:
      // an admin may set it, a member of the public may not.
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(
             ['name', 'address', 'email', 'category', 'contestCategory', 'status', 'submittedAt', 'source', 'mapPointId']);
    }

    /*
     * Senoia Halloween — the public trick-or-treat map.
     *
     * Readable by everyone, writable only by an admin. An admin publishes an
     * approved residential address here (address only — never the name or
     * email from the sign-up) and adds road closures and parking directly.
     *
     * lat/lng may be null: an unplaced pin is skipped by the map, which is what
     * lets the site run without a geocoding service.
     */
    match /halloween_map_points/{pointId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(
             ['address', 'lat', 'lng', 'kind', 'label', 'createdAt'])
        && request.resource.data.kind in ['residential', 'closure', 'parking']
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 200;
      allow delete: if isAdmin();
    }

    /*
     * Volunteer sign-ups (/volunteer/:eventSlug), ported from the Senoia Car
     * Show's volunteer system.
     *
     * volunteer_events/{eventSlug}          name, intro, signupOpen (the close switch)
     * volunteer_events/{eventSlug}/shifts   role, time, note, spotsTotal, spotsFilled, sortOrder
     * volunteer_signups/{id}                volunteer PII + cancelToken + status
     *
     * Events and shifts are public (counts only, no PII). Signups are never
     * publicly readable and never client-created: volunteers have no account,
     * so the submitVolunteerSignup / cancelVolunteerSignup functions write them
     * with the Admin SDK inside a transaction.
     *
     * `spotsFilled` is owned by that transaction. An admin may create a shift
     * (at 0) and edit everything else; the only change they may make to the
     * count is to release one spot, which is what removing a volunteer does
     * (src/services/volunteerService.js, in a client transaction).
     */
    function isValidVolunteerEvent() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'intro', 'signupOpen', 'updatedAt'])
        && d.keys().hasAll(['name', 'signupOpen'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.signupOpen is bool
        && optString(d, 'intro', 2000);
    }

    function isValidVolunteerShift() {
      let d = request.resource.data;
      return d.keys().hasOnly(['role', 'time', 'note', 'spotsTotal', 'spotsFilled', 'sortOrder'])
        && d.keys().hasAll(['role', 'time', 'spotsTotal', 'spotsFilled', 'sortOrder'])
        && d.role is string && d.role.size() > 0 && d.role.size() <= 120
        && d.time is string && d.time.size() > 0 && d.time.size() <= 120
        && optString(d, 'note', 500)
        && d.spotsTotal is int && d.spotsTotal >= 1 && d.spotsTotal <= 500
        && d.spotsFilled is int && d.spotsFilled >= 0
        && d.sortOrder is number;
    }

    match /volunteer_events/{eventSlug} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidVolunteerEvent();
      allow delete: if isAdmin();

      match /shifts/{shiftId} {
        allow read: if true;
        allow create: if isAdmin() && isValidVolunteerShift()
          && request.resource.data.spotsFilled == 0;
        allow update: if isAdmin() && isValidVolunteerShift()
          && (request.resource.data.spotsFilled == resource.data.spotsFilled
              || request.resource.data.spotsFilled == resource.data.spotsFilled - 1);
        allow delete: if isAdmin();
      }
    }

    match /volunteer_signups/{signupId} {
      allow read: if isAdmin();
      // Staff may only cancel a sign-up; nothing else on it can change.
      allow update: if isAdmin()
        && resource.data.status == 'active'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']);
      allow create, delete: if false;
    }
  }
}
