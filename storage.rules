rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in [
          "jermdw@gmail.com",
          "welcome@enjoysenoia.com",
          "treasurer@enjoysenoia.com",
          "webmaster@enjoysenoia.com"
        ] || request.auth.token.admin == true
      );
    }

    // {rest=**} matches zero or more segments, so this covers every object,
    // root-level ones included.
    match /{top}/{rest=**} {
      // Everything is public except private/, which only the Admin SDK reads
      // (the Masquerade's Red Carpet print files, served through the
      // redCarpetPhotos function to guests with a link). A narrower match
      // below could not take this back: any rule that allows, allows.
      allow read: if top != 'private';
      // The site itself writes only under news/ (below). The migrated Webflow
      // assets were uploaded with admin credentials, which bypass these rules,
      // as does the Firebase console. Before this an admin's browser session
      // could overwrite or delete any object in the bucket.
    }

    // Images the News editor uploads: admin-only, new images only, 10 MB cap
    // (MAX_IMAGE_BYTES in src/services/newsService.js).
    match /news/{slug}/{fileName} {
      // New files only (resource == null): uploads get timestamped names, so
      // an overwrite would only ever replace a photo a live story points at.
      allow create: if isAdmin()
        && resource == null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isAdmin();
    }
  }
}
